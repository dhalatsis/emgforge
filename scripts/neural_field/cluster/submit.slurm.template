#!/bin/bash
# ===========================================================================
# SLURM submit TEMPLATE for the anatomy-conditioning experiment.
# Fill in the <<...>> fields for the specific cluster. Same run_job.py as PBS.
#
#   Stage 1 (CPU FEM): sbatch submit.slurm.cpu       -> capture <JOBID>
#   Stage 2 (GPU):     sbatch --dependency=afterok:<JOBID> submit.slurm.gpu
#
# Array sizes from:  python scripts/neural_field/cluster/run_job.py --list
# ===========================================================================

# ----- STAGE 1: CPU FEM generation -----------------------------------------
#SBATCH --job-name=emg_gen
#SBATCH --partition=<<CPU_PARTITION>>
#SBATCH --account=<<ACCOUNT>>
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --array=0-41
#SBATCH --output=logs/gen.%a.out

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"                    # submit from the repo root
export PYTHONPATH=src

# --- activate the ONE env (dolfinx 0.7.3 + gmsh + torch) — pick ONE line ---
# module load <<DOLFINX_MODULE>>
# source /shared/conda/etc/profile.d/conda.sh && conda activate fenicsx-env
# source /shared/venvs/fenicsx-env/bin/activate
<<ENV_ACTIVATE>>

python scripts/neural_field/cluster/run_job.py --where cpu --index "$SLURM_ARRAY_TASK_ID"

# ===========================================================================
# ----- STAGE 2: GPU (submit.slurm.gpu) — this file with the header below ----
#   #SBATCH --job-name=emg_train
#   #SBATCH --partition=<<GPU_PARTITION>>
#   #SBATCH --gres=gpu:1
#   #SBATCH --cpus-per-task=8
#   #SBATCH --mem=32G
#   #SBATCH --time=01:00:00
#   #SBATCH --array=0-9
#   ... same cd / env activate ...
#   python scripts/neural_field/cluster/run_job.py --where gpu --index "$SLURM_ARRAY_TASK_ID"
# ===========================================================================
