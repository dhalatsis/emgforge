# --- migration notes + results/sanity galleries: LOCAL-ONLY, never commit ---
# (_results/ is a self-contained subfolder you can version separately)
_migration/
_results/

# --- scratch: MRI pipeline survey, kept out of refactor/ to avoid collisions ---
_refactor-mri/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- envs ---
.venv/
venv/
env/
ENV/
.env

# --- editors / OS ---
.vscode/
.idea/
.DS_Store

# --- test / type / cache ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- notebooks ---
.ipynb_checkpoints/

# --- heavy / generated artifacts (regenerable — keep out of git) ---
data/
datasets/
meshes/
*.msh
*.xdmf
*.h5
figures/
*.png
*.npz
*.npy
# Exception: tiny, deterministic *test fixtures* (not bulk data) must be committed.
# Small sanity/verification fixtures opt back in with a `!` rule like this one:
!**/golden_cylindrical.npz
# All committed test fixtures live here (golden_cylindrical.npz, muap_reference.npz, …):
!tests/synthesis/data/
!tests/synthesis/data/*.npz
# Committed MRI anatomy data (tiny: WR segmentation 77K + label map), imported from
# the neural-forward-emg archive so the MU-pool pipeline is self-contained here.
!src/emgforge/mri/data/
!src/emgforge/mri/data/*.nii.gz
!src/emgforge/mri/data/*.json
# heavy regression snapshots (regenerable)
tests/regression/snapshots/*.json
tests/regression/neumann_meshes/

# --- configurable data root (symlink or env) ---
/mnt_data

# Local-only refactor scratch (design notes, never committed)
_refactor/

# investigation working folders (plots + summaries; committed refs live in docs/)
_investigations/

# paper: keep the figure sources/PDFs, drop render scratch
!paper/figures/
!paper/figures/**
paper/figures/__pycache__/
paper/_pages/
paper/main.log
paper/main.aux
paper/main.bbl
paper/main.blg
paper/*.stub
!paper/datasets/
!paper/datasets/**
